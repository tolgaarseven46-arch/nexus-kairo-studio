# GEMINI_API_KEY: Required for legacy Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public application URL.
APP_URL="MY_APP_URL"

# Kaira integration transport.
KAIRA_API_URL="https://nexus-kairo-studio.onrender.com"
KAIRA_INTEGRATION_TOKEN="REPLACE_WITH_SHARED_INTEGRATION_TOKEN"
KAIRA_INTERNAL_TOKEN="REPLACE_WITH_PRIVATE_INTERNAL_TOKEN"

# Canonical Kaira principal to provision in PrivatRoom.
KAIRA_DEFAULT_INSTANCE_ID="kaira_reference_001"
KAIRA_DEFAULT_DISPLAY_NAME="Kaira"
KAIRA_DEFAULT_ROLE_TITLE="Droit"
KAIRA_DEFAULT_AVATAR_URL=""

# Required for server-side Firebase Admin operations: authenticated Kaira ingress,
# durable outbox/action execution, and Kaira principal provisioning.
# Use a service account from the same Firebase project as firebase-applet-config.json.
# Paste the complete Firebase service-account JSON as one environment variable value.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}'
# PrivatRoom uses the Nexus project's default Firestore database.
# Do not set FIREBASE_DATABASE_ID for this deployment.
