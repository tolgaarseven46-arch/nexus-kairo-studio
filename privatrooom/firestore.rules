rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /directConversations/{conversationId} {
      function isParticipantFromResource() {
        return request.auth != null &&
          request.auth.uid in resource.data.participantIds;
      }

      function isParticipantFromRequest() {
        return request.auth != null &&
          request.resource.data.participantIds is list &&
          request.resource.data.participantIds.size() == 2 &&
          request.auth.uid in request.resource.data.participantIds;
      }

      allow create: if isParticipantFromRequest();
      allow read: if isParticipantFromResource();
      allow update: if isParticipantFromResource() &&
        request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/directConversations/$(conversationId));
        }

        function isConversationParticipant() {
          return request.auth != null &&
            request.auth.uid in parentConversation().data.participantIds;
        }

        function immutableIdentityFieldsStaySame() {
          return request.resource.data.eventId == resource.data.eventId &&
            request.resource.data.conversationId == resource.data.conversationId &&
            request.resource.data.senderUid == resource.data.senderUid &&
            request.resource.data.kind == resource.data.kind &&
            request.resource.data.createdAt == resource.data.createdAt;
        }

        allow read: if isConversationParticipant();
        allow create: if isConversationParticipant() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.eventId == messageId;
        allow update: if isConversationParticipant() &&
          resource.data.senderUid == request.auth.uid &&
          immutableIdentityFieldsStaySame();
        allow delete: if false;
      }
    }

    match /rooms/{roomId} {
      function signedIn() {
        return request.auth != null;
      }

      function immutableRoomAuthorityFieldsStaySame() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'creatorUid',
          'createdAt',
          'betaCreated',
          'kairaPresence'
        ]);
      }

      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn() && immutableRoomAuthorityFieldsStaySame();
      allow delete: if signedIn() && resource.data.creatorUid == request.auth.uid;

      match /messages/{messageId} {
        function signedIn() {
          return request.auth != null;
        }

        function immutableMessageIdentityFieldsStaySame() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id',
            'senderUid',
            'createdAtServer',
            'messageSource'
          ]);
        }

        allow read: if true;
        allow create: if signedIn() &&
          request.resource.data.id == messageId &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.messageSource == null;
        allow update: if signedIn() &&
          resource.data.senderUid == request.auth.uid &&
          immutableMessageIdentityFieldsStaySame();
        allow delete: if signedIn() &&
          resource.data.senderUid == request.auth.uid;
      }
    }

    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.player1Id == request.auth.uid;
      allow update: if request.auth != null && (
        (
          resource.data.gameStatus == 'waiting' &&
          (resource.data.player2Id == request.auth.uid || request.resource.data.player2Id == request.auth.uid)
        ) ||
        (resource.data.currentPlayerId == request.auth.uid) ||
        (resource.data.player1Id == request.auth.uid || resource.data.player2Id == request.auth.uid)
      );
      allow delete: if false;
    }

    match /tavlaGames/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
